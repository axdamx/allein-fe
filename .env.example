# ============================================================================
# Allein — environment variables template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored;
# `.env.example` is committed as documentation only — never put real secrets
# here.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: bypasses RLS. Server-only. Rotate if ever exposed.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Mastra storage + pgvector)
SUPABASE_DATABASE_URL=

# --- LLM (ZAI / Zhipu GLM — OpenAI-compatible) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=
# Chat defaults to disabled for faster first-token latency. Use enabled when
# deeper model reasoning is more important than response speed.
LLM_CHAT_THINKING=disabled
# NOTE: AI media generation (Studio images/video) reuses LLM_BASE_URL + LLM_API_KEY

# Per-replica limits for memory-heavy local AI jobs. Raise only after measuring
# production peak memory under realistic concurrent traffic.
EMBEDDING_MAX_CONCURRENCY=1
OCR_MAX_CONCURRENCY=1

# --- Telegram Bot (required for Telegram messaging) ---
TELEGRAM_BOT_TOKEN=
# Secret token Telegram sends in the X-Telegram-Bot-Api-Secret-Token header
# on every webhook update. Generate a random string and pass it when
# registering the webhook (setWebhook with secret_token). The webhook at
# /api/messaging/telegram REJECTS requests without a matching header.
TELEGRAM_WEBHOOK_SECRET=

# --- Twilio (required for WhatsApp messaging) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Mastra Platform (optional — hosted observability + Studio) ---
MASTRA_PLATFORM_ACCESS_TOKEN=
